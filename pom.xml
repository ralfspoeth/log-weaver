<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.ralfspoeth</groupId>
        <artifactId>plumbum</artifactId>
        <version>3.0.3</version>
    </parent>

    <artifactId>log-weaver</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <name>Log Weaver (parent)</name>
    <description>
        Bytecode-level logging weaver driven by the Log/LogAll annotations from log-api.
        Modules:
        - log-api                 : the Log / LogAll annotation types
        - log-weaver-core         : transformation engine (no build-tool dependencies)
        - log-weaver-maven-plugin : @Mojo wrapping the core for the Maven build
        - log-weaver-agent        : Java agent wrapping the core as a ClassFileTransformer
        - log-weaver-bom          : Bill of Materials importing all of the above at one version
    </description>

    <url>https://github.com/ralfspoeth/log-weaver</url>

    <properties>
        <revision>1.0</revision>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <scm>
        <url>scm:git:https://github.com/ralfspoeth/log-weaver</url>
        <developerConnection>scm:git:https://github.com/ralfspoeth/log-weaver.git</developerConnection>
        <tag>HEAD</tag>
    </scm>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>


    <developers>
        <developer>
            <id>ralfspoeth</id>
            <name>Ralf Spöth</name>
            <email>ralf.spoeth@gmail.com</email>
            <url>https://github.com/ralfspoeth</url>
        </developer>
    </developers>

    <modules>
        <module>log-api</module>
        <module>log-weaver-core</module>
        <module>log-weaver-maven-plugin</module>
        <module>log-weaver-agent</module>
        <module>log-weaver-bom</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>log-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>log-weaver-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>6.1.3</version>
                <scope>import</scope>
                <type>pom</type>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <redirectTestOutputToFile>true</redirectTestOutputToFile>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- Central requires javadoc + sources jars (and signatures of both)
                 on every deployed artifact, so these have to run for every
                 module — not just the Maven-plugin module. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
            </plugin>
            <!-- inherited release plumbing from plumbum stays in place -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-release-plugin</artifactId>
            </plugin>
            <!--
              CI-friendly versioning: with <version>${revision}</version>, the raw
              POM contains the unresolved property. Central-consumed artifacts have
              no reactor to fall back on, so the property has to be substituted
              before install/deploy. flatten-maven-plugin writes a flattened POM
              to target/.flattened-pom.xml and rewires install/deploy to use it.
              resolveCiFriendliesOnly leaves the rest of the POM alone
              (dependencyManagement, plugin config, etc.) and only substitutes
              ${revision} / ${sha1} / ${changelist}.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>1.8.0</version>
                <configuration>
                    <flattenMode>resolveCiFriendliesOnly</flattenMode>
                    <updatePomFile>true</updatePomFile>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten.clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
